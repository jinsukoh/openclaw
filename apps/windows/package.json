{
    "name": "openclaw-windows",
    "version": "0.0.1",
    "private": true,
    "description": "Windows wrapper for OpenClaw",
    "author": "OpenClaw Team",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc && electron-builder build --win --x64",
        "pack": "tsc && electron-builder --dir",
        "start": "tsc && electron ."
    },
    "dependencies": {
        "electron-serve": "^1.3.0",
        "better-sqlite3": "^11.5.0",
        "sqlite-vec": "0.1.7-alpha.2",
        "sharp": "^0.34.5",
        "@lydell/node-pty": "1.2.0-beta.3",
        "@napi-rs/canvas": "^0.1.89",
        "node-llama-cpp": "3.15.1",
        "playwright-core": "1.58.1"
    },
    "devDependencies": {
        "electron": "^34.0.0",
        "electron-builder": "^26.0.0",
        "typescript": "^5.7.3",
        "@types/node": "^22.0.0"
    },
    "build": {
        "appId": "ai.openclaw.windows",
        "productName": "OpenClaw",
        "directories": {
            "output": "dist-installer"
        },
        "asarUnpack": [
            "backend/**/*"
        ],
        "files": [
            "dist/**/*",
            "backend/**/*",
            "!**/*.map"
        ],
        "win": {
            "target": "nsis",
            "icon": "../../apps/macos/Sources/OpenClaw/Resources/OpenClaw.icns"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}